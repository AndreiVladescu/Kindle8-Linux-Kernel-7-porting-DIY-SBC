 	REGMAP_IRQ_REG(BD71815_INT_DCIN_MON_RES, 2, BD71815_INT_DCIN_MON_RES_MASK),
 	REGMAP_IRQ_REG(BD71815_INT_DCIN_MON_DET, 2, BD71815_INT_DCIN_MON_DET_MASK),
 	REGMAP_IRQ_REG(BD71815_INT_WDOG, 2, BD71815_INT_WDOG_MASK),
+	REGMAP_IRQ_REG(BD71815_INT_PWRON_LONG, 2, BD71815_INT_PWRON_LONG_MASK),
+	REGMAP_IRQ_REG(BD71815_INT_PWRON_MID, 2, BD71815_INT_PWRON_MID_MASK),
+	REGMAP_IRQ_REG(BD71815_INT_PWRON_SHORT, 2, BD71815_INT_PWRON_SHORT_MASK),
+	REGMAP_IRQ_REG(BD71815_INT_PWRON_PRESS, 2, BD71815_INT_PWRON_PRESS_MASK),
 	/* Vsys */
 	REGMAP_IRQ_REG(BD71815_INT_VSYS_UV_RES, 3, BD71815_INT_VSYS_UV_RES_MASK),
