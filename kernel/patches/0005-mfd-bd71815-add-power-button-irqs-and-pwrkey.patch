+		 * INT_STAT_03 bits 2-5; use the short push like the BD71828.
 		 */
-		button_irq = 0;
+		button_irq = BD71815_INT_PWRON_SHORT;
 		break;
 	case ROHM_CHIP_TYPE_BD72720:
 	{
